<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'Order Manager' | trans }}{% endblock %}</title>
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset("img/icon.png") }}"/>

    {{ encore_entry_link_tags('login') }}
    {{ encore_entry_script_tags('login') }}

</head>
<body>
<div class="text-center">
    <form class="form-signin" method="post" autocomplete="off">
        <img class="mb-4" src="{{ asset('img/kadamaxo.png') }}" alt="" width="72" height="72">
        <h5 class="h6 mb-3 font-weight-normal">{{ 'Order Manager for Kadamaxo' | trans }}</h5>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey | trans(error.messageData, 'security') }}</div>{% endif %}

        <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" placeholder="{{ 'login' | trans }}" required autofocus>
        <br/>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="{{ 'password' | trans }}" required>
        <br/>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn btn-lg btn-primary btn-block" type="submit">{{ 'Log in' | trans }}</button>
        <p class="mt-5 mb-3 copyright">© {{  'Order Manager' | trans }} 2020-{{ date() | date('Y') }}</p>
    </form>
</div>
</body>