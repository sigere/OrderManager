        </div>
        {% block popups %}
            <div class="popup-wrapper" data-controller="popup">
                <div class="overlay" data-popup-target="overlay"></div>
                <div class="popup">
                    <div id="center-popup-content" data-popup-target="content">
                        {% include 'icons/loading.html' %}
                    </div>
