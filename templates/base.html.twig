<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        {% block title %}
            {{ 'Order Manager' | trans }}
        {% endblock %}
    </title>
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset("img/icon.png") }}"/>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}

    {% endblock %}
</head>
{% block body %}
    <body style="overflow-x: hidden;">
    {% block header %}
        <header class="navbar sticky-top flex-md-nowrap p-0 shadow">
            <a class="navbar-brand" id="title" href="{{ path('orders') }}">
                <img src="{{ asset('img/logo.svg') }}"/>
            </a>
            <ul class="navbar-nav px-3">
                <li class="nav-item text-nowrap nav-link">
                    <img src="{{ asset('img/kadamaxo.png') }}" height="25px"/>
                    <span style="display: inline-block;">Kadamaxo | {{ app.user.firstName }} {{ app.user.lastName }} |</span>
                    <a style="display: inline-block;" class="nav-link" href="/logout">
                        {{ 'logout' | trans }}
                    </a>
                </li>
            </ul>
        </header>
    {% endblock %}
    <div class="wrapper">
        {% block nav %}
            <nav data-controller="sidebar" id="sidebar" class="active">
                <ul class="list-unstyled components">
                    <li {% if app.request.attributes.get('_route') == "orders" %}class="current-tab"{% endif %}>
                        <a href="{{ path('orders') }}">
                            <div id="nav-home" class="item-container">
                                {%  include 'icons/order.html' %}
                                <h6>{{ 'Orders' | trans }}</h6>
                            </div>
                        </a>
