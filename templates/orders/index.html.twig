{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }}
    - {{ 'Orders' | trans }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('orders') }}
{% endblock %}

{% block javascript %}
{{ parent() }}
{{ encore_entry_script_tags('orders') }}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-2" style=" height: 100%;">
            <div class="column left-col js-left-col" data-controller="orders-left-col">
                <header data-orders-left-col-target="header">
                    {{ 'Filter' | trans }}
                </header>
                <div class="col-content" id="filters-content" data-orders-left-col-target="content" {# todo #} data-controller="filters">
                    {{ include('orders/_filters.html.twig') }}
                </div>
            </div>
        </div>
        <div class="col-lg-7" style=" height: 100%;">
            <div class="column mid-col js-mid-col" data-controller="order-mid-col">
                <header data-order-mid-col-target="header">
                    <div class="icon" style="float: left;">
                        {% include 'icons/order.html' %}
                    </div>
                    {{ 'Orders' | trans }}
                    <div style="clear: both;"></div>
                    {% include '_burger.html.twig' with {flat: true, options: [
                        {label: 'Add order', icon: 'add', attributes: {'data-controller': 'order-create'}},
                        {label: 'Search', icon: 'search', attributes: {'data-controller': 'search'}},
                    ]} %}
                </header>
                <div class="col-content" data-order-mid-col-target="content">
                    {% include 'orders/_table.html.twig' %}
                </div>
            </div>
        </div>
        <div class="col-lg-3" style="height: 100%;">
            <div class="column right-col js-right-col" data-controller="order-right-col">
                <header data-order-right-col-target="header">
                    {{ 'Order details' | trans }}
                    <span data-order-right-col-target="id">
                            {% if details['order'] %}
                                {{ details['order'].id }}
                            {% endif %}
                    </span>
                    <div class="js-burger">
                        {% include '_burger.html.twig' %}
                    </div>
                </header>
                <div class="col-content" data-order-right-col-target="details">
                    {% if details['order'] %}
                        {% include 'orders/_details.html.twig' with {'order': details['order'], 'logs': details['logs']} %}
                    {% else %}
                        <div class="alert alert-info">{{ "Select order to display details." | trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
