<table class="table table-dark table-hover entity-table"
       role="grid"
       data-controller="table"
        {% include 'attributes.html.twig' with {attributes: endpointData} %}
    >
    <thead>
    <tr>
        <th class="entity-table icon-col"></th>
        <th class="entity-table icon-col"></th>
        <th>id</th>
        {% if 'adoption' in preferences.columns %}
            <th>{{ 'adoption' | trans | capitalize }}</th>
        {% endif %}
        {% if 'client' in preferences.columns %}
            <th>{{ 'client' | trans | capitalize }}</th>
        {% endif %}
        {% if 'topic' in preferences.columns %}
            <th>{{ 'topic' | trans | capitalize }}</th>
        {% endif %}
        {% if 'lang' in preferences.columns %}
            <th>{{ 'language' | trans | capitalize }}</th>
        {% endif %}
        {% if 'deadline' in preferences.columns %}
            <th>{{ 'deadline' | trans | capitalize }}</th>
        {% endif %}
        {% if 'staff' in preferences.columns %}
            <th>{{ 'staff' | trans | capitalize }}</th>
        {% endif %}

        <th>{{ 'change status' | trans | capitalize }}</th>
    </tr>
    </thead>
    <tbody>
    {% for order in orders %}
        {% include "orders/_table_row.html.twig" with {order: order} %}
    {% endfor %}
    </tbody>
</table>
{% if orders is empty %}
    <div class="alert alert-primary">{{ "No results - check filters" | trans }}</div>
{% endif %}
