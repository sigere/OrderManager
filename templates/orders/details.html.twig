{% if order.deletedAt is not null %}
{#todo warnings from php#}
{#    <div class="alert alert-danger">Zlecenie zostało usunięte {{ order.deletedAt|date("d-m-Y H:i") }}.</div>#}
{% elseif order.getWarnings is not empty %}
    <div class="warning">
        <ul class="list-group">
            {% for w in order.getWarnings %}
                <li>{{ w }}</li>
            {% endfor %}
        </ul>
    </div>
{% elseif order.settledAt is not null %}
    {#todo warnings from php#}
{#    <div class="alert alert-success">Zlecenie zostało rozliczone.</div>#}
{% endif %}

{% if order.repertoryEntry is not null %}
    <div class="expandable">
        <div class="trigger">
            <div class="property js-repertory-entry-number" data-entry="{{ order.repertoryEntry.id }}">
                <div class="name">{{ 'Entry number' | trans }}</div>
                <div class="value">
                    {{ order.repertoryEntry.formattedNumber }}
                    {% include 'icons/expand.html' %}
                </div>
            </div>
            <div style="clear:both;"></div>
        </div>
        <div class="body">
            {% include 'orders/entry_summary.html.twig' with {"entry": order.repertoryEntry} %}
        </div>
    </div>
{% endif %}

{% set properties = [
    {
        name: 'State',
        value: order.state | trans | capitalize,
        attr: [{name:'state', value: order.state}]
    },
    {
        name: 'Adoption',
        value: order.adoption | date('d.m.Y H:i'),
    },
    {
        name: 'Deadline',
        value: order.deadline | date('d.m.Y H:i'),
    },
    {
        name: 'Client',
        value: order.client.name,
    },
    {
        name: 'Topic',
        value: order.topic,
    },
    {
        name: 'Language',
        value: order.baseLang ~ ' -> ' ~ order.targetLang,
    },
    {
        name: 'Certified',
        value: order.certified ? "Yes" | trans : "No" | trans,
    },
    {
        name: 'Assignee',
        value: order.staff.firstName ~ ' ' ~ order.staff.lastName,
    },
    {
        name: 'Additional notes',
        value: order.info | default('no notes' | trans),
    },
    {
        name: 'Pages',
        value: order.pages | number_format(2, ".", ""),
    },
    {
        name: 'Price per page',
        value: order.price | number_format(2, ".", ""),
    },
    {
        name: 'Additional fee',
        value: order.additionalFee | number_format(2, ".", ""),
    },
    {
        name: 'Netto',
        value: order.netto | number_format(2, ".", ""),
    },
]
%}

{% for property in properties %}
    {% include 'orders/details_property.html.twig' %}
{% endfor %}


<div class="logs">
    <table class="table table-dark">
        <thead>
        <th>Data</th>
        <th>Użytkownik</th>
        <th>Akcja</th>
        </thead>
        <tbody>
        {% for l in logs %}
            <tr>
                <td style="width: min-content;">{{ l.createdAt | date('d-m-Y H:i:s') }}</td>
                <td style="width: min-content;">{{ l.user.firstName ~ ' ' ~ l.user.lastName }}</td>
                <td>{{ l.action }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
